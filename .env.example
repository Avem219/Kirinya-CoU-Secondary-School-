# Copy this file to .env.local for local development. Never commit the
# real .env / .env.local file — only this .env.example template is tracked.
#
# Naming convention: any variable NOT prefixed with NEXT_PUBLIC_ is
# server-only and is never bundled into client-side JavaScript. All
# variables below are currently server-only.

# --- Database (schema exists; not yet consumed by application code) ---
# Required by prisma/schema.prisma's datasource block. No repository in
# src/lib/repositories currently reads this — they all point at in-memory
# dev adapters (see docs/database.md). Setting this alone does NOT connect
# the app to a database; it only enables `npx prisma generate` /
# `npx prisma migrate dev` to run.
DATABASE_URL="postgresql://user:password@localhost:5432/kirinya"

# --- Admin auth bootstrap (development only) ---
# Seeds a single Super Admin account in the in-memory dev user store
# (src/lib/dev-store/user-store.ts) so you can sign in at /admin/login
# before a database is connected. Has no effect once a real
# PrismaUserRepository is wired in — create users properly at that point.
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="choose-a-strong-password"

# --- Application URL (PLANNED — not yet read by any code) ---
# Intended for absolute URLs (metadataBase, OG images, sitemap) once those
# are generated dynamically instead of the hardcoded value currently in
# src/app/(site)/layout.tsx. Left commented out because no code references
# it yet — see docs/architecture.md.
# NEXT_PUBLIC_SITE_URL="https://kirinyacouss.sc.ug"

# --- Object storage (media library — not yet configured) ---
# Any S3-compatible provider. Required before /admin/media can actually
# persist uploads — see docs/media-policy.md.
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
